---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CvSection from "@/components/cv/CvSection.astro";
import JobItem from "@/components/cv/JobItem.astro";
import SkillList from "@/components/cv/SkillList.astro";
import PixelCard from "@/components/ui/PixelCard.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { profile } from "@/data/profile";
import type { Lang } from "@/i18n/config";
import { langStaticPaths, useTranslations } from "@/i18n/utils";

export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={t("cv.title")} description={t("cv.description")}>
  <PixelCard accent>
    <SectionTitle as="h1">{profile.name}</SectionTitle>
    <p
      class="mt-4 font-pixel text-[0.65rem] leading-relaxed text-accent-2 sm:text-xs"
    >
      {profile.role[lang]}
    </p>
    <p class="mt-2 text-sm text-muted">{profile.location[lang]}</p>
    <p class="mt-6 max-w-2xl">{profile.about[lang]}</p>
  </PixelCard>

  <CvSection title={t("cv.experience")}>
    <ol class="grid gap-6">
      {
        profile.experience.map((job) => (
          <li>
            <JobItem job={job} lang={lang} />
          </li>
        ))
      }
    </ol>
  </CvSection>

  <CvSection title={t("cv.skills")}>
    <div class="grid gap-8 sm:grid-cols-2">
      {profile.skills.map((group) => <SkillList group={group} lang={lang} />)}
    </div>
  </CvSection>

  <CvSection title={t("cv.education")}>
    <ul class="grid gap-4">
      {
        profile.education.map(({ degree, school, start, end }) => (
          <li class="flex flex-wrap items-baseline justify-between gap-2">
            <span>
              {degree[lang]} <span class="text-accent-2">@ {school}</span>
            </span>
            <span class="text-xs text-muted">
              {start} — {end}
            </span>
          </li>
        ))
      }
    </ul>
  </CvSection>

  <CvSection title={t("cv.contacts")}>
    <ul class="flex flex-wrap gap-4">
      {
        profile.links.map(({ label, href }) => (
          <li>
            <a
              href={href}
              rel="me noopener"
              class="text-accent-2 underline decoration-dashed underline-offset-4 hover:decoration-solid"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </CvSection>
</BaseLayout>
