---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/blog/PostList.astro";
import Container from "@/components/ui/Container.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import type { Lang } from "@/i18n/config";
import { langStaticPaths, useTranslations } from "@/i18n/utils";
import { getPosts } from "@/lib/posts";

export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = await getPosts(lang);
---

<BaseLayout title={t("blog.title")} description={t("blog.description")}>
  <Container class="pt-36 pb-24 sm:pt-44">
    <SectionHeader
      as="h1"
      index="01"
      label={t("blog.title")}
      title={t("home.writing")}
      intro={t("blog.description")}
    />
    <PostList posts={posts} lang={lang} />
  </Container>
</BaseLayout>
