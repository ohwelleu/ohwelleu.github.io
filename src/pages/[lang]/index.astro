---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/blog/PostList.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Icon from "@/components/ui/Icon.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { profile } from "@/data/profile";
import type { Lang } from "@/i18n/config";
import { langStaticPaths, localizePath, useTranslations } from "@/i18n/utils";
import { getPosts } from "@/lib/posts";

export const getStaticPaths = langStaticPaths;

const LATEST_POSTS = 3;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = await getPosts(lang);
const github = profile.links.find(({ label }) => label === "GitHub");
---

<BaseLayout>
  <Container class="pt-40 pb-24 sm:pt-52 sm:pb-32">
    <Eyebrow>{t("site.description")}</Eyebrow>
    <h1
      class="mt-6 text-8xl leading-none font-medium tracking-tight sm:text-9xl"
    >
      TBD
    </h1>

    <div class="mt-12 flex flex-wrap gap-3">
      <Button href={localizePath(lang, "/blog")} dot>
        {t("hero.cta")}
        <Icon name="arrowRight" class="size-3.5" />
      </Button>
      {
        github && (
          <Button href={github.href} variant="soft" rel="me noopener">
            {github.label}
            <Icon name="arrowUpRight" class="size-3.5" />
          </Button>
        )
      }
    </div>
  </Container>

  <section class="dark bg-ink text-fg">
    <Container class="py-24 sm:py-32">
      <SectionHeader index="01" label={t("nav.blog")} title={t("home.writing")}>
        <Button href={localizePath(lang, "/blog")} variant="soft">
          {t("home.allPosts")}
          <Icon name="arrowRight" class="size-3.5" />
        </Button>
      </SectionHeader>
      <PostList
        posts={posts.slice(0, LATEST_POSTS)}
        total={posts.length}
        lang={lang}
      />
    </Container>
  </section>
</BaseLayout>
