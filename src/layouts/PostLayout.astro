---
import type { Lang } from "@/i18n/config";
import { formatDate, localizePath, useTranslations } from "@/i18n/utils";
import type { Post } from "@/lib/posts";
import BaseLayout from "./BaseLayout.astro";
import PostMeta from "@/components/blog/PostMeta.astro";
import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Icon from "@/components/ui/Icon.astro";
import TagList from "@/components/ui/TagList.astro";

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const { title, description, tags, updatedDate } = post.data;
const t = useTranslations(lang);
---

<BaseLayout title={title} description={description}>
  <article>
    <Container size="text" class="pt-36 pb-24 sm:pt-44 sm:pb-32">
      <a
        href={localizePath(lang, "/blog")}
        class="inline-flex items-center gap-2 eyebrow text-muted hover:text-fg"
      >
        <Icon name="arrowLeft" class="size-3.5" />
        {t("blog.back")}
      </a>

      <header class="mt-10 border-b border-line pb-10">
        <PostMeta post={post} lang={lang} />
        <h1
          class="mt-5 text-4xl leading-[1.05] font-medium tracking-tight text-balance sm:text-6xl"
        >
          {title}
        </h1>
        <p class="mt-6 text-xl text-muted">{description}</p>
        {
          updatedDate && (
            <Eyebrow class="mt-4">
              {t("blog.updated")}: {formatDate(updatedDate, lang)}
            </Eyebrow>
          )
        }
        <div class="mt-8">
          <TagList tags={tags} />
        </div>
      </header>

      <div class="prose-editorial prose prose-lg mt-12 max-w-none">
        <slot />
      </div>
    </Container>
  </article>
</BaseLayout>
