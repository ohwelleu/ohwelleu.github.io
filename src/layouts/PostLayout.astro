---
import type { Lang } from "@/i18n/config";
import { formatDate, localizePath, useTranslations } from "@/i18n/utils";
import type { Post } from "@/lib/posts";
import BaseLayout from "./BaseLayout.astro";
import PostMeta from "@/components/blog/PostMeta.astro";
import PixelIcon from "@/components/ui/PixelIcon.astro";
import TagList from "@/components/ui/TagList.astro";

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const { title, description, tags, updatedDate } = post.data;
const t = useTranslations(lang);
---

<BaseLayout title={title} description={description}>
  <article>
    <a
      href={localizePath(lang, "/blog")}
      class="inline-flex items-center gap-2 text-xs text-muted hover:text-accent"
    >
      <PixelIcon name="arrowLeft" class="size-3" />
      {t("blog.back")}
    </a>

    <header class="mt-8 border-b-4 border-dashed border-line pb-8">
      <PostMeta post={post} lang={lang} />
      <h1
        class="mt-4 font-pixel text-lg leading-relaxed text-accent text-glow sm:text-2xl"
      >
        {title}
      </h1>
      <p class="mt-4 text-muted">{description}</p>
      {
        updatedDate && (
          <p class="mt-2 text-xs text-muted">
            {t("blog.updated")}: {formatDate(updatedDate, lang)}
          </p>
        )
      }
      <div class="mt-6">
        <TagList tags={tags} />
      </div>
    </header>

    <div class="prose mt-10 max-w-none prose-retro">
      <slot />
    </div>
  </article>
</BaseLayout>
