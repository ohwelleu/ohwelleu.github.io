---
interface Props {
  title?: string;
  class?: string;
}

const { title = "~/terminal", class: className } = Astro.props;
---

<div class:list={["m-1 bg-surface pixel-border", className]}>
  <div class="flex items-center gap-2 border-b-4 border-line px-4 py-2">
    <span class="size-3 bg-accent-2" aria-hidden="true"></span>
    <span class="size-3 bg-accent" aria-hidden="true"></span>
    <span class="size-3 bg-muted" aria-hidden="true"></span>
    <span class="ml-2 truncate text-xs text-muted">{title}</span>
  </div>
  <div class="p-5 sm:p-6">
    <slot />
  </div>
</div>
