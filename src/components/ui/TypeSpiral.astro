---
/**
 * Concentric rings of text that slowly turn in opposite directions.
 * Pure SVG + CSS: no JavaScript, and it stops for reduced-motion users.
 */
interface Props {
  words: string[];
  rings?: number;
  class?: string;
}

const { words, rings = 12, class: className } = Astro.props;

const SIZE = 1000;
const CENTER = SIZE / 2;
const INNER_RADIUS = 48;
const OUTER_RADIUS = 700;
const CHAR_WIDTH = 0.6; // Geist Mono glyph width in em

const phrase = `${words.join(" · ")} · `;

const ringData = Array.from({ length: rings }, (_, i) => {
  const progress = i / (rings - 1);
  const radius = INNER_RADIUS + progress * (OUTER_RADIUS - INNER_RADIUS);
  const fontSize = 11 + progress * 15;
  const circumference = 2 * Math.PI * radius;
  const repeats = Math.max(
    1,
    Math.round(circumference / (phrase.length * fontSize * CHAR_WIDTH)),
  );

  return {
    id: `type-spiral-ring-${i}`,
    path: `M ${CENTER - radius},${CENTER} a ${radius},${radius} 0 1,1 ${radius * 2},0 a ${radius},${radius} 0 1,1 ${-radius * 2},0`,
    text: phrase.repeat(repeats),
    fontSize,
    length: circumference,
    opacity: 0.25 + progress * 0.75,
    reverse: i % 2 === 1,
  };
});
---

<svg
  viewBox={`0 0 ${SIZE} ${SIZE}`}
  class:list={["font-mono uppercase", className]}
  aria-hidden="true"
>
  <defs>
    {ringData.map(({ id, path }) => <path id={id} d={path} />)}
  </defs>
  {
    ringData.map(({ id, text, fontSize, length, opacity, reverse }) => (
      <g class={reverse ? "spin-slow-reverse" : "spin-slow"}>
        <text
          font-size={fontSize}
          fill="currentColor"
          fill-opacity={opacity}
          textLength={length}
          lengthAdjust="spacing"
        >
          <textPath href={`#${id}`}>{text}</textPath>
        </text>
      </g>
    ))
  }
  <circle cx={CENTER} cy={CENTER} r="6" class="fill-accent"></circle>
</svg>
