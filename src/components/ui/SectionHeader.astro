---
import Eyebrow from "./Eyebrow.astro";

interface Props {
  /** Section number shown above the title, e.g. "01". */
  index: string;
  label: string;
  title: string;
  intro?: string;
  as?: "h1" | "h2";
}

const { index, label, title, intro, as: Tag = "h2" } = Astro.props;
---

<header
  class="flex flex-col gap-6 border-b border-line pb-10 md:flex-row md:items-end md:justify-between"
>
  <div class="max-w-2xl">
    <Eyebrow>{index} / {label}</Eyebrow>
    <Tag
      class="mt-4 text-4xl leading-[1.05] font-medium tracking-tight sm:text-5xl"
    >
      {title}
    </Tag>
    {intro && <p class="mt-5 text-lg text-muted">{intro}</p>}
  </div>
  <slot />
</header>
