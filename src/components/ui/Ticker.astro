---
/**
 * A single line of text scrolling sideways. The content is rendered twice
 * so the loop is seamless; the copy is hidden from screen readers.
 */
interface Props {
  text: string;
  href?: string;
  class?: string;
}

const { text, href, class: className } = Astro.props;
const Tag = href ? "a" : "div";
const items = Array.from({ length: 4 }, () => text);
---

<Tag
  href={href}
  class:list={["block overflow-hidden whitespace-nowrap", className]}
>
  <div class="flex w-max marquee">
    {
      [false, true].map((hidden) => (
        <span class="flex shrink-0" aria-hidden={hidden ? "true" : undefined}>
          {items.map((item) => (
            <span class="px-4">{item}</span>
          ))}
        </span>
      ))
    }
  </div>
</Tag>
