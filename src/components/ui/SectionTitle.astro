---
interface Props {
  as?: "h1" | "h2" | "h3";
  class?: string;
}

const { as: Tag = "h2", class: className } = Astro.props;
---

<Tag
  class:list={[
    "font-pixel leading-snug text-accent text-glow",
    Tag === "h1" ? "text-lg sm:text-2xl" : "text-sm sm:text-base",
    className,
  ]}
>
  <span class="text-muted" aria-hidden="true">&gt;</span>
  <slot />
</Tag>
