---
interface Props {
  class?: string;
}

const { class: className = "size-7" } = Astro.props;
---

<svg viewBox="0 0 28 28" fill="none" class={className} aria-hidden="true">
  <circle cx="14" cy="14" r="12.5" stroke="currentColor" stroke-width="1.5"
  ></circle>
  <circle
    cx="14"
    cy="14"
    r="8"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-dasharray="2 2.5"></circle>
  <circle cx="14" cy="14" r="3.5" class="fill-accent"></circle>
</svg>
