---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & {
  variant?: "primary" | "ghost";
};

const { variant = "primary", class: className, ...rest } = Astro.props;
---

<a
  class:list={[
    "m-1 inline-flex items-center gap-3 px-4 py-3 font-pixel text-[0.65rem] tracking-wider uppercase transition-transform active:translate-y-0.5",
    variant === "primary"
      ? "bg-accent text-bg pixel-border-accent hover:brightness-110"
      : "bg-surface text-fg pixel-border hover:text-accent",
    className,
  ]}
  {...rest}
>
  <slot />
</a>
