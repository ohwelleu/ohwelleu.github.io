---
import type { Lang } from "@/i18n/config";
import { localizePath, useTranslations } from "@/i18n/utils";
import { getPostSlug, type Post } from "@/lib/posts";
import PixelCard from "@/components/ui/PixelCard.astro";
import PixelIcon from "@/components/ui/PixelIcon.astro";
import TagList from "@/components/ui/TagList.astro";
import PostMeta from "./PostMeta.astro";

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const href = localizePath(lang, `/blog/${getPostSlug(post)}`);
---

<PixelCard
  as="article"
  class="group relative transition-transform hover:-translate-y-0.5"
>
  <PostMeta post={post} lang={lang} />
  <h3 class="mt-3 font-pixel text-xs leading-relaxed sm:text-sm">
    <a href={href} class="text-fg group-hover:text-accent">
      <span class="absolute inset-0" aria-hidden="true"></span>
      {post.data.title}
    </a>
  </h3>
  <p class="mt-3 text-sm text-muted">{post.data.description}</p>
  <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <TagList tags={post.data.tags} />
    <span class="inline-flex items-center gap-2 text-xs text-accent-2">
      {t("blog.readMore")}
      <PixelIcon name="arrowRight" class="size-3" />
    </span>
  </div>
</PixelCard>
