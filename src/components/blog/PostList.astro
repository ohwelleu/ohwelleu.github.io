---
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/utils";
import type { Post } from "@/lib/posts";
import PostRow from "./PostRow.astro";

interface Props {
  /** Newest first, as returned by `getPosts`. */
  posts: Post[];
  lang: Lang;
  /** Total number of posts, so numbering stays stable when the list is cut. */
  total?: number;
}

const { posts, lang, total = posts.length } = Astro.props;
const t = useTranslations(lang);
---

{
  posts.length > 0 ? (
    <ol>
      {posts.map((post, index) => (
        <li>
          <PostRow post={post} lang={lang} number={total - index} />
        </li>
      ))}
    </ol>
  ) : (
    <p class="py-10 text-muted">{t("blog.empty")}</p>
  )
}
