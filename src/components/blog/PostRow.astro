---
import type { Lang } from "@/i18n/config";
import { localizePath } from "@/i18n/utils";
import { getPostSlug, type Post } from "@/lib/posts";
import Icon from "@/components/ui/Icon.astro";
import PostMeta from "./PostMeta.astro";

interface Props {
  post: Post;
  lang: Lang;
  /** Position in the archive, oldest post = 1. */
  number: number;
}

const { post, lang, number } = Astro.props;
const href = localizePath(lang, `/blog/${getPostSlug(post)}`);
---

<article
  class="group relative grid gap-4 border-b border-line py-8 sm:grid-cols-[6rem_1fr_auto] sm:gap-8"
>
  <p class="eyebrow text-muted">{String(number).padStart(3, "0")}</p>

  <div>
    <h3
      class="text-2xl leading-tight font-medium tracking-tight transition-colors group-hover:text-accent sm:text-3xl"
    >
      <a href={href}>
        <span class="absolute inset-0" aria-hidden="true"></span>
        {post.data.title}
      </a>
    </h3>
    <p class="mt-3 max-w-2xl text-muted">{post.data.description}</p>
    <PostMeta post={post} lang={lang} class="mt-4" />
  </div>

  <span
    class="hidden size-11 place-items-center self-center rounded-lg bg-surface transition-colors group-hover:bg-accent group-hover:text-white sm:grid"
    aria-hidden="true"
  >
    <Icon name="arrowRight" />
  </span>
</article>
