---
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n/utils";
import { navItems } from "@/lib/nav";
import Icon from "@/components/ui/Icon.astro";
import Logo from "@/components/ui/Logo.astro";
import LangSwitcher from "./LangSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homePath = localizePath(lang);

function isActive(path: string): boolean {
  const href = localizePath(lang, path);
  return href === homePath
    ? Astro.url.pathname === href
    : Astro.url.pathname.startsWith(href);
}
---

<header class="fixed inset-x-0 top-3 z-50 flex justify-center px-3 sm:top-4">
  <!-- Always-dark floating bar, in both themes -->
  <div
    class="dark flex w-full max-w-xl items-center gap-1 border border-white/10 bg-ink p-1.5 text-fg shadow-xl shadow-black/20"
  >
    <Logo class="px-3 text-sm" />

    <nav aria-label={t("nav.main")} class="flex-1">
      <ul class="flex">
        {
          navItems.map(({ key, path, icon }) => {
            const active = isActive(path);
            return (
              <li>
                <a
                  href={localizePath(lang, path)}
                  aria-current={active ? "page" : undefined}
                  aria-label={icon ? t(key) : undefined}
                  title={icon ? t(key) : undefined}
                  class:list={[
                    "grid h-9 place-items-center eyebrow",
                    icon ? "w-9" : "px-3",
                    active ? "bg-surface" : "text-muted hover:text-fg",
                  ]}
                >
                  {icon ? <Icon name={icon} /> : t(key)}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <LangSwitcher />
    <ThemeToggle />
  </div>
</header>
