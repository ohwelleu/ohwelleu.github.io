---
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/utils";
import type { Job } from "@/data/profile";
import PixelCard from "@/components/ui/PixelCard.astro";

interface Props {
  job: Job;
  lang: Lang;
}

const { job, lang } = Astro.props;
const t = useTranslations(lang);
---

<PixelCard as="article">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="font-pixel text-xs leading-relaxed text-fg">{job.role[lang]}</h3>
    <p class="text-xs text-muted">{job.start} — {job.end ?? t("cv.present")}</p>
  </div>
  <p class="mt-1 text-sm text-accent-2">@ {job.company}</p>
  <p class="mt-3 text-sm">{job.summary[lang]}</p>
  <ul class="mt-3 space-y-1 text-sm text-muted">
    {
      job.highlights.map((item) => (
        <li class="flex gap-2">
          <span class="text-accent" aria-hidden="true">
            *
          </span>
          {item[lang]}
        </li>
      ))
    }
  </ul>
</PixelCard>
