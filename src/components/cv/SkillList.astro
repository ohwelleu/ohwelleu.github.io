---
import type { Lang } from "@/i18n/config";
import type { SkillGroup } from "@/data/profile";

interface Props {
  group: SkillGroup;
  lang: Lang;
}

const { group, lang } = Astro.props;
---

<div>
  <h3 class="mb-3 text-xs tracking-widest text-muted uppercase">
    {group.title[lang]}
  </h3>
  <ul class="flex flex-wrap gap-2">
    {
      group.items.map((item) => (
        <li class="m-1 bg-surface px-2 py-1 text-sm pixel-border">{item}</li>
      ))
    }
  </ul>
</div>
